NODE_ENV=production
DEMO_MODE=true
STORAGE=csv
PORT=3000
TZ=Asia/Hong_Kong

SESSION_SECRET=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS

DEMO_ADMIN_EMAIL=YOUR_POLYU_EMAIL
DEMO_ADMIN_PASSWORD=REPLACE_WITH_A_STRONG_DEMO_PASSWORD

REGISTRATION_ALLOWED_DOMAINS=connect.polyu.hk,polyu.edu.hk

MAIL_TRANSPORT=log
MAIL_FROM=no-reply@example.invalid
APP_BASE_URL=

# Assignment 3 assistant. Set LLM_PROVIDER=none to use only the deterministic baseline.
ASSISTANT_TURN_MODE=hybrid
ASSISTANT_IDLE_MS=1200
ASSISTANT_MAX_WAIT_MS=3600
LLM_PROVIDER=openai
OPENAI_API_MODE=responses
OPENAI_API_KEY=
OPENAI_TURN_MODEL=gpt-6-luna
OPENAI_CHAT_MODEL=gpt-6.1-sol

# Remote MCP endpoint used by the OpenAI Responses API. Generate a random secret.
MCP_SERVER_TOKEN=

# Optional standalone stdio MCP ticket tools (demo-only credentials).
MCP_DEMO_EMAIL=
MCP_DEMO_PASSWORD=
